# Copy to .env for local testing, and add the same keys in Netlify:
# Site configuration -> Environment variables

# Real domain, used for canonical URLs, sitemap and share images
SITE_URL=https://example.com
# GA4 Measurement ID (Admin -> Data streams -> Web). Leave empty to disable analytics.
PUBLIC_GA4_ID=
# Optional: Google Search Console "HTML tag" verification code (only the content="..." value)
PUBLIC_GSC_VERIFICATION=
