---
import { url } from '../lib/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from './Photo.astro';
import Gallery from './Gallery.astro';
import ProjectCard from './ProjectCard.astro';
import CtaSection from './CtaSection.astro';
import { CATEGORY_LABELS, getRelatedProjects, type Project } from '../lib/content';
import { whatsappMessages } from '../lib/whatsapp';
import { t } from '../i18n/en';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const d = project.data;
const related = await getRelatedProjects(project, 2);
const waMessage = whatsappMessages.project(d.title);

const description =
  d.seo.description ??
  `${d.isConcept ? 'Concept ' : ''}${CATEGORY_LABELS[d.category].toLowerCase()} photography project: ${d.goal}`.slice(0, 160);

const brief = [
  { label: t.project.goal, text: d.goal },
  { label: t.project.idea, text: d.idea },
  { label: t.project.usage, text: d.usage },
  { label: t.project.role, text: d.role },
];
---

<BaseLayout
  title={d.seo.title ?? d.title}
  description={description}
  image={d.coverImage.src}
  ogType="article"
  whatsappMessage={waMessage}
>
  <article>
    <header class="container head">
      <nav aria-label="Breadcrumb" class="crumbs eyebrow">
        <a href={url('/work')}>{t.nav.work}</a> / <a href={url(`/work/${d.category}`)}>{CATEGORY_LABELS[d.category]}</a>
      </nav>
      <h1>{d.title}</h1>
      <div class="meta">
        {d.isConcept && <span class="badge-concept">{t.common.conceptBadge}</span>}
        {d.client && !d.isConcept && (
          <p>
            <span class="muted">{t.project.client}:</span> {d.client}
          </p>
        )}
      </div>
      {d.isConcept && <p class="muted concept-note">{t.common.conceptNote}</p>}
    </header>

    <div class="container cover">
      <Photo image={d.coverImage} sizes="(min-width: 82rem) 82rem, 100vw" priority />
    </div>

    <section class="container section brief" aria-labelledby="brief">
      <h2 id="brief">{t.project.brief}</h2>
      <div>
        <dl class="brief__list">
          {
            brief.map((b) => (
              <div>
                <dt class="eyebrow">{b.label}</dt>
                <dd>{b.text}</dd>
              </div>
            ))
          }
        </dl>
        {
          d.services.length > 0 && (
            <div class="services">
              <h3 class="eyebrow">{t.project.services}</h3>
              <ul role="list" class="tags">
                {d.services.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </section>

    <section class="container" aria-labelledby="gallery">
      <h2 id="gallery" class="visually-hidden">{t.project.gallery}</h2>
      <Gallery images={d.gallery} />
    </section>
  </article>

  <div class="section--tight"></div>
  <CtaSection title={t.project.ctaTitle} text={t.project.ctaText} whatsappMessage={waMessage} service={d.category} location="project" />

  {
    related.length > 0 && (
      <section class="section" aria-labelledby="related">
        <div class="container">
          <div class="section-head">
            <h2 id="related">
              {t.project.related} {CATEGORY_LABELS[d.category].toLowerCase()} work
            </h2>
            <a class="link-arrow" href={url(`/work/${d.category}`)}>
              {t.common.seeAll}
            </a>
          </div>
          <ul role="list" class="related">
            {related.map((p) => (
              <li>
                <ProjectCard project={p} sizes="(min-width: 48em) 50vw, 100vw" />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .head {
    padding-block: clamp(2rem, 1rem + 4vw, 4.5rem) 2rem;
  }
  .crumbs {
    margin-block-end: 1.25rem;
  }
  .crumbs a {
    text-decoration: none;
  }
  .crumbs a:hover {
    text-decoration: underline;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-block-start: 1.25rem;
  }
  .meta:empty {
    display: none;
  }
  .concept-note {
    margin-block-start: 0.75rem;
    font-size: var(--step--1);
    max-inline-size: 40rem;
  }
  .cover :global(img) {
    inline-size: 100%;
    max-block-size: 85vh;
    object-fit: cover;
  }
  .brief {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 56em) {
    .brief {
      grid-template-columns: 1fr 2fr;
      gap: 4rem;
    }
  }
  .brief__list {
    display: grid;
    gap: 1.75rem;
    margin: 0;
  }
  @media (min-width: 40em) {
    .brief__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .brief__list div {
    border-block-start: 1px solid var(--line);
    padding-block-start: 1rem;
  }
  .brief__list dd {
    margin: 0.4rem 0 0;
  }
  .services {
    margin-block-start: 2.5rem;
  }
  .services h3 {
    margin-block-end: 0.75rem;
  }
  .related {
    display: grid;
    gap: 2.5rem 2rem;
  }
  @media (min-width: 48em) {
    .related {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
