---
import { url } from '../lib/url';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import wordmark from '../assets/brand/shotix-wordmark-on-dark.png';
import { HALLS } from '../lib/content';
import { t } from '../i18n/en';

interface Props {
  siteName: string;
  services: CollectionEntry<'services'>[];
}

const { siteName, services } = Astro.props;
// Pages are built as files (contact.html), so normalise before comparing.
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '');
const isActive = (prefix: string) => path === url(prefix) || path.startsWith(`${url(prefix)}/`);
---

<header class="site-header">
  <div class="container bar">
    <a class="logo" href={url('/')} aria-label={`${siteName} — ${t.nav.home}`}>
      <Image src={wordmark} alt="" height={30} densities={[1, 2, 3]} loading="eager" />
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="menu-toggle__open">{t.nav.menu}</span>
      <span class="menu-toggle__close">{t.nav.close}</span>
    </button>

    <nav id="site-nav" class="nav" aria-label="Main">
      <ul role="list" class="nav__list">
        <li><a href={url('/work')} aria-current={isActive('/work') ? 'page' : undefined}>{t.nav.work}</a></li>
        <li class="has-sub">
          <button type="button" class="sub-toggle" aria-expanded="false" aria-controls="services-sub">
            {t.nav.services}
          </button>
          <ul role="list" id="services-sub" class="sub">
            {
              services.map((s) => (
                <li>
                  <a href={url(`/services/${s.id}`)} aria-current={isActive(`/services/${s.id}`) ? 'page' : undefined}>
                    <span class="hall" aria-hidden="true">{HALLS[s.data.category]}</span>
                    {s.data.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </li>
        <li><a href={url('/about')} aria-current={isActive('/about') ? 'page' : undefined}>{t.nav.about}</a></li>
        <li><a href={url('/contact')} aria-current={isActive('/contact') ? 'page' : undefined}>{t.nav.contact}</a></li>
      </ul>
    </nav>

    <a class="btn header-cta" href={url('/contact')} data-event="start_project_click" data-event-location="header">
      {t.nav.startProject}
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    background: var(--bg);
    border-block-end: 1px solid var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-block-size: var(--header-h);
  }

  .logo {
    margin-inline-end: auto;
    padding-block: 0.5rem;
  }
  .logo :global(img) {
    block-size: 1.6rem;
    inline-size: auto;
  }
  @media (min-width: 56em) {
    .logo :global(img) {
      block-size: 1.9rem;
    }
  }

  .header-cta {
    min-block-size: 2.5rem;
    padding: 0.5em 1em;
    font-size: var(--step--1);
    white-space: nowrap;
    display: none;
  }

  .menu-toggle,
  .sub-toggle {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .menu-toggle {
    min-block-size: 2.75rem;
    padding-inline: 0.75rem;
    border: 1px solid var(--line);
    font: 800 var(--step-0) / 1 var(--font-sign);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .menu-toggle[aria-expanded='true'] {
    border-color: var(--gold);
    color: var(--gold);
  }
  .menu-toggle__close,
  .menu-toggle[aria-expanded='true'] .menu-toggle__open {
    display: none;
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__close {
    display: inline;
  }

  .nav a,
  .sub-toggle {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    padding-block: 0.7rem;
    font-family: var(--font-sign);
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .nav a:hover,
  .sub-toggle:hover {
    color: var(--gold);
  }
  .nav a[aria-current='page'] {
    color: var(--gold);
  }
  .hall {
    display: inline-grid;
    place-items: center;
    inline-size: 1.6em;
    block-size: 1.6em;
    background: var(--gold);
    color: var(--on-gold);
    font-weight: 900;
    line-height: 1;
  }
  .sub-toggle::after {
    content: '';
    display: inline-block;
    inline-size: 0.4em;
    block-size: 0.4em;
    margin-inline-start: 0.2em;
    /* physical sides on purpose: a down-pointing chevron in both LTR and RTL */
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: translateY(-0.2em) rotate(45deg);
  }

  /* Mobile: full-width directory panel */
  .nav {
    display: none;
    position: absolute;
    inset-inline: 0;
    inset-block-start: 100%;
    background: var(--bg);
    border-block-end: 1px solid var(--line);
    padding: 0.5rem var(--gutter) 1.5rem;
    max-block-size: calc(100dvh - var(--header-h));
    overflow-y: auto;
  }
  .nav.is-open {
    display: block;
  }
  .nav__list > li {
    border-block-end: 1px solid var(--line);
    font-size: var(--step-2);
  }
  .sub {
    display: none;
    padding-block-end: 0.75rem;
    font-size: var(--step-1);
  }
  .sub-toggle[aria-expanded='true'] + .sub {
    display: block;
  }

  @media (min-width: 56em) {
    .menu-toggle {
      display: none;
    }
    .header-cta {
      display: inline-flex;
      order: 3;
    }
    .nav {
      display: block;
      position: static;
      padding: 0;
      background: none;
      border: 0;
      overflow: visible;
      max-block-size: none;
      margin-inline-end: 1.25rem;
    }
    .nav__list {
      display: flex;
      gap: 1.75rem;
    }
    .nav__list > li {
      border: 0;
      font-size: var(--step-0);
    }
    .has-sub {
      position: relative;
    }
    .sub {
      position: absolute;
      inset-block-start: 100%;
      inset-inline-start: -1rem;
      min-inline-size: 18rem;
      padding: 0.5rem 1rem;
      background: var(--bg);
      border: 1px solid var(--line);
      box-shadow: 0 18px 40px rgb(0 0 0 / 0.5);
      font-size: var(--step-0);
    }
    .has-sub:hover .sub {
      display: block;
    }
    .sub a {
      white-space: nowrap;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.getElementById('site-nav');
  const subToggle = document.querySelector<HTMLButtonElement>('.sub-toggle');

  const setMenu = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    nav?.classList.toggle('is-open', open);
  };
  const setSub = (open: boolean) => subToggle?.setAttribute('aria-expanded', String(open));

  toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
  subToggle?.addEventListener('click', () => setSub(subToggle.getAttribute('aria-expanded') !== 'true'));

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (subToggle?.getAttribute('aria-expanded') === 'true') {
      setSub(false);
      subToggle.focus();
    } else if (toggle?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      toggle.focus();
    }
  });

  // Close the desktop services dropdown when focus or a click leaves it.
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('.has-sub')) setSub(false);
  });
  document.querySelector('.has-sub')?.addEventListener('focusout', (e) => {
    const next = (e as FocusEvent).relatedTarget as Node | null;
    if (!next || !(e.currentTarget as Element).contains(next)) setSub(false);
  });
</script>
