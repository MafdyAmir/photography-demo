---
/**
 * Portfolio grid with category filter (PRD FR-4).
 * Every category has its own static page (/work/product …) so links can be shared and indexed;
 * with JS, the filter switches in place and updates the URL without a reload.
 */
import ProjectCard from './ProjectCard.astro';
import { BASE, url } from '../lib/url';
import { CATEGORY_LABELS, HALLS, type Category, type Project } from '../lib/content';
import { t } from '../i18n/en';

interface Props {
  projects: Project[];
  categories: Category[];
  active: Category | 'all';
  /** Titles per filter, so document.title stays right when filtering in place. */
  titles: Record<string, string>;
  /** Booth code per project id. */
  codes: Record<string, string>;
}

const { projects, categories, active, titles, codes } = Astro.props;
const filters: { key: string; label: string; hall?: string; href: string }[] = [
  { key: 'all', label: t.common.allWork, href: url('/work') },
  ...categories.map((c) => ({ key: c, label: CATEGORY_LABELS[c], hall: HALLS[c], href: url(`/work/${c}`) })),
];
---

<div class="work" data-work data-base={BASE} data-titles={JSON.stringify(titles)}>
  {
    filters.length > 2 && (
      <nav class="filters" aria-label={t.work.filterLabel}>
        <ul role="list">
          {filters.map((f) => (
            <li>
              <a href={f.href} data-filter={f.key} aria-current={f.key === active ? 'page' : undefined}>
                {f.hall && <b aria-hidden="true">{f.hall}</b>}
                <span>{f.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  <ul role="list" class="grid">
    {
      projects.map((p) => (
        <li data-category={p.data.category} hidden={active !== 'all' && p.data.category !== active}>
          <ProjectCard project={p} code={codes[p.id]} headingLevel="h2" />
        </li>
      ))
    }
  </ul>
  {projects.length === 0 && <p class="muted">{t.work.empty}</p>}
</div>

<style>
  /* One swipeable row on phones, wrapping on wider screens. */
  .filters ul {
    display: flex;
    gap: 0.5rem;
    margin-block-end: 2.5rem;
    overflow-x: auto;
    scrollbar-width: none;
    margin-inline-end: calc(var(--gutter) * -1);
    padding-inline-end: var(--gutter);
  }
  .filters li {
    flex: none;
  }
  @media (min-width: 48em) {
    .filters ul {
      flex-wrap: wrap;
      overflow: visible;
      margin-inline-end: 0;
      padding-inline-end: 0;
    }
  }
  .filters a {
    display: inline-flex;
    align-items: stretch;
    min-block-size: 2.75rem;
    border: 1px solid var(--line);
    text-decoration: none;
    font: 800 var(--step--1) / 1 var(--font-sign);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .filters a > * {
    display: grid;
    place-items: center;
    padding-inline: 0.8em;
  }
  .filters b {
    background: var(--line);
    color: var(--ink);
    font-weight: 900;
    min-inline-size: 2.75rem;
  }
  .filters a:hover {
    border-color: var(--gold);
  }
  .filters a[aria-current='page'] {
    border-color: var(--gold);
    color: var(--gold);
  }
  .filters a[aria-current='page'] b {
    background: var(--gold);
    color: var(--on-gold);
  }
  .grid {
    display: grid;
    gap: clamp(2.5rem, 2rem + 2vw, 4rem) clamp(1rem, 0.5rem + 2vw, 2.5rem);
  }
  @media (min-width: 40em) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 64em) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-work]');
  if (root) {
    const titles: Record<string, string> = JSON.parse(root.dataset.titles ?? '{}');
    const links = root.querySelectorAll<HTMLAnchorElement>('[data-filter]');
    const items = root.querySelectorAll<HTMLElement>('[data-category]');

    const apply = (key: string) => {
      items.forEach((li) => (li.hidden = key !== 'all' && li.dataset.category !== key));
      links.forEach((a) => {
        if (a.dataset.filter === key) a.setAttribute('aria-current', 'page');
        else a.removeAttribute('aria-current');
      });
      if (titles[key]) document.title = titles[key];
    };

    links.forEach((a) =>
      a.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
        e.preventDefault();
        const key = a.dataset.filter!;
        apply(key);
        history.pushState({ filter: key }, '', a.href);
      }),
    );

    window.addEventListener('popstate', () => {
      const rel = location.pathname.slice((root.dataset.base ?? '').length).replace(/\/$/, '');
      const seg = rel.split('/')[2];
      apply(seg && titles[seg] ? seg : 'all');
    });
  }
</script>
