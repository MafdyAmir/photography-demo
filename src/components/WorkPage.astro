---
/** Shared by /work and /work/[category]. */
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkListing from './WorkListing.astro';
import CtaSection from './CtaSection.astro';
import { CATEGORY_LABELS, getActiveCategories, getBoothCodes, getPublishedProjects, getSettings, type Category } from '../lib/content';
import { t } from '../i18n/en';

interface Props {
  active: Category | 'all';
}

const { active } = Astro.props;
const settings = await getSettings();
const projects = await getPublishedProjects();
const categories = await getActiveCategories();
const codes = Object.fromEntries(await getBoothCodes());

const pageTitle = (key: Category | 'all') =>
  key === 'all' ? `${t.work.title} — Events, Exhibitions & Brand Content` : `${CATEGORY_LABELS[key]} — Photo & Video Work`;
const pageDescription =
  active === 'all'
    ? `Event, exhibition, launch and brand content we've covered in photo and video — ${settings.siteName}, ${settings.location.city}.`
    : `${CATEGORY_LABELS[active]} we've covered in photo and video — ${settings.siteName}, ${settings.location.city}.`;

const titles = Object.fromEntries(
  (['all', ...categories] as const).map((k) => [k, `${pageTitle(k)} | ${settings.siteName}`]),
);
---

<BaseLayout title={pageTitle(active)} description={pageDescription}>
  <section class="section work route">
    <div class="container indent">
      <header class="intro">
        <h1>{t.work.title}</h1>
        <p class="lead">{t.work.intro}</p>
      </header>
      <WorkListing projects={projects} categories={categories} active={active} titles={titles} codes={codes} />
    </div>
  </section>
  <CtaSection title={settings.finalCtaTitle} text={settings.finalCtaText} location="work" />
</BaseLayout>

<style>
  .work {
    padding-block-start: clamp(2rem, 1rem + 4vw, 4rem);
  }
  .indent {
    padding-inline-start: var(--indent);
  }
  .intro {
    margin-block-end: 2.5rem;
  }
  .intro .lead {
    margin-block-start: 1rem;
  }
</style>
