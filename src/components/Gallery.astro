---
/**
 * Project gallery with lightGallery lightbox & justified-layout:
 * Justified photo grid on page (with CSS flex fallback + lightGallery justified-layout enhancement);
 * clicking opens lightGallery with zoom-from-origin, thumbnails bar, pinch/click zoom,
 * swipe gestures, keyboard arrows, and real alt captions.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Photo from './Photo.astro';
import { t } from '../i18n/en';
import 'lightgallery/css/lightgallery.css';
import 'lightgallery/css/lg-zoom.css';
import 'lightgallery/css/lg-thumbnail.css';
import 'lightgallery/css/lg-justified.css';

interface Props {
  images: { src: ImageMetadata; alt: string }[];
}

const { images } = Astro.props;

// Large versions for the lightbox, generated at build time.
const full = await Promise.all(
  images.map(async (img) => {
    const widths = [800, 1400, 2000].filter((w) => w < img.src.width).concat(Math.min(img.src.width, 2400));
    const res = await getImage({ src: img.src, widths, format: 'webp', quality: 78 });
    return { src: res.src, srcset: res.srcSet.attribute };
  }),
);

// High-performance thumbnail versions for lightGallery thumbnail strip.
const thumbs = await Promise.all(
  images.map(async (img) => {
    const res = await getImage({ src: img.src, width: 200, format: 'webp', quality: 72 });
    return res.src;
  }),
);
---

<div class="gallery" data-gallery>
  <div class="gallery__grid">
    {
      images.map((img, i) => (
        <a
          href={full[i].src}
          class="gallery__item"
          style={`--r: ${(img.src.width / img.src.height).toFixed(3)}`}
          data-src={full[i].src}
          data-srcset={full[i].srcset}
          data-thumb={thumbs[i]}
          data-lg-size={`${img.src.width}-${img.src.height}`}
          data-sub-html={`<div class="lg-caption"><p class="lg-caption__alt">${img.alt}</p></div>`}
          aria-label={`${t.project.openImage} ${i + 1}: ${img.alt}`}
        >
          <Photo image={img} sizes="(min-width: 48em) 50vw, 100vw" />
        </a>
      ))
    }
  </div>
</div>

<style>
  /* Justified rows: keeps the CMS order left-to-right, equal height per row.
     Grow and basis both scale with each image's aspect ratio (--r). */
  .gallery__grid {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.75rem, 0.5rem + 1vw, 1.5rem);
  }
  .gallery__item {
    display: block;
    flex: var(--r) 1 calc(var(--r) * 100%);
    padding: 0;
    border: 0;
    background: var(--surface);
    cursor: zoom-in;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  @media (min-width: 48em) {
    .gallery__item {
      flex-basis: calc(var(--r) * 18rem);
    }
  }
  .gallery__item:hover {
    opacity: 0.92;
  }
  .gallery__item :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  /* Shotix Studios Exhibition Theme styling for lightGallery */
  :global(.lg-backdrop) {
    background-color: #050506 !important;
  }
  :global(.lg-outer .lg-thumb-outer) {
    background-color: #0a0a0b !important;
    border-block-start: 1px solid var(--line);
  }
  :global(.lg-outer .lg-thumb-item) {
    border-radius: 0 !important;
    border: 2px solid transparent !important;
    cursor: pointer;
    transition: border-color 0.2s, opacity 0.2s;
  }
  :global(.lg-outer .lg-thumb-item.active),
  :global(.lg-outer .lg-thumb-item:hover) {
    border-color: var(--gold) !important;
  }
  :global(.lg-toolbar) {
    background: linear-gradient(180deg, rgba(10, 10, 11, 0.9) 0%, transparent 100%) !important;
  }
  :global(.lg-toolbar .lg-icon) {
    color: var(--ink) !important;
    transition: color 0.2s;
  }
  :global(.lg-toolbar .lg-icon:hover) {
    color: var(--gold) !important;
  }
  :global(.lg-actions .lg-next),
  :global(.lg-actions .lg-prev) {
    border-radius: 0 !important;
    background-color: rgb(255 255 255 / 0.08) !important;
    color: var(--ink) !important;
    border: 0 !important;
    transition: background-color 0.2s, color 0.2s;
  }
  :global(.lg-actions .lg-next:hover),
  :global(.lg-actions .lg-prev:hover) {
    background-color: var(--gold) !important;
    color: var(--on-gold) !important;
  }
  [dir='rtl'] :global(.lg-actions .lg-prev svg),
  [dir='rtl'] :global(.lg-actions .lg-next svg) {
    transform: scaleX(-1);
  }
  :global(.lg-sub-html) {
    background: linear-gradient(0deg, rgba(10, 10, 11, 0.9) 0%, transparent 100%) !important;
    padding-block-end: 1rem !important;
  }
  :global(.lg-caption) {
    text-align: center;
  }
  :global(.lg-caption__alt) {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--step--1);
    color: var(--muted);
    letter-spacing: 0.02em;
  }
  :global(#lg-counter) {
    font-family: var(--font-sign) !important;
    font-weight: 700 !important;
    font-size: var(--step--1) !important;
    color: var(--muted) !important;
    letter-spacing: 0.08em;
  }
  :global(.lg-progress-bar .lg-progress) {
    background-color: var(--gold) !important;
  }
</style>

<script>
  const galleries = document.querySelectorAll<HTMLElement>('[data-gallery]');

  galleries.forEach(async (galleryEl) => {
    const grid = galleryEl.querySelector<HTMLElement>('.gallery__grid');
    if (!grid) return;

    const [{ default: lightGallery }, { default: lgThumbnail }, { default: lgZoom }, { default: lgJustified }] = await Promise.all([
      import('lightgallery'),
      import('lightgallery/plugins/thumbnail'),
      import('lightgallery/plugins/zoom'),
      import('lightgallery/plugins/justified'),
    ]);

    lightGallery(grid, {
      selector: '.gallery__item',
      plugins: [lgThumbnail, lgZoom, lgJustified],
      justified: true,
      justifiedRowHeight: 280,
      justifiedGap: 12,
      justifiedLastRow: 'start',
      zoomFromOrigin: true,
      startAnimationDuration: 350,
      speed: 350,
      download: false,
      counter: true,
      mousewheel: true,
      enableDrag: true,
      enableSwipe: true,
      thumbWidth: 80,
      thumbHeight: '60px',
      thumbMargin: 8,
      mobileSettings: {
        controls: true,
        showCloseIcon: true,
        download: false,
      },
    });
  });
</script>
