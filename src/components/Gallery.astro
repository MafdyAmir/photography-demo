---
/**
 * Project gallery + lightbox (PRD FR-5): a Swiper inside a native <dialog> (focus trap + Esc).
 * Swipe, pinch/double-tap zoom, arrow keys. Swiper loads on the first open; slides carry real alt text.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Photo from './Photo.astro';
import { t } from '../i18n/en';

interface Props {
  images: { src: ImageMetadata; alt: string }[];
}

const { images } = Astro.props;
const L = t.project.lightbox;

// Large versions for the lightbox, generated at build time.
const full = await Promise.all(
  images.map(async (img) => {
    const widths = [800, 1400, 2000].filter((w) => w < img.src.width).concat(Math.min(img.src.width, 2400));
    const res = await getImage({ src: img.src, widths, format: 'webp', quality: 78 });
    return { src: res.src, srcset: res.srcSet.attribute };
  }),
);
---

<div class="gallery" data-gallery>
  <ul role="list" class="gallery__grid">
    {
      images.map((img, i) => (
        <li style={`--r: ${(img.src.width / img.src.height).toFixed(3)}`}>
          <button
            type="button"
            class="gallery__item"
            data-index={i}
            aria-label={`${t.project.openImage} ${i + 1}: ${img.alt}`}
          >
            <Photo image={img} sizes="(min-width: 48em) 50vw, 100vw" />
          </button>
        </li>
      ))
    }
  </ul>

  <dialog class="lightbox" aria-label={L.label}>
    <div class="swiper lightbox__swiper">
      <div class="swiper-wrapper">
        {
          images.map((img, i) => (
            <div class="swiper-slide">
              <div class="swiper-zoom-container">
                <img src={full[i].src} srcset={full[i].srcset} sizes="100vw" alt={img.alt} loading="lazy" draggable="false" />
              </div>
            </div>
          ))
        }
      </div>
    </div>
    <p class="lightbox__caption">
      <span class="lightbox__count" aria-live="polite"></span>
      <span class="lightbox__alt" aria-hidden="true"></span>
    </p>
    <button type="button" class="lb-btn lb-close" data-close aria-label={L.close}><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="square"></path></svg></button>
    <button type="button" class="lb-btn lb-prev" data-prev aria-label={L.prev}><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="square"></path></svg></button>
    <button type="button" class="lb-btn lb-next" data-next aria-label={L.next}><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="square"></path></svg></button>
  </dialog>
</div>

<style>
  /* Justified rows: keeps the CMS order left-to-right, equal height per row.
     Grow and basis both scale with each image's aspect ratio (--r). */
  .gallery__grid {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.75rem, 0.5rem + 1vw, 1.5rem);
  }
  .gallery__grid li {
    flex: var(--r) 1 calc(var(--r) * 100%);
  }
  @media (min-width: 48em) {
    .gallery__grid li {
      flex-basis: calc(var(--r) * 18rem);
    }
  }
  .gallery__item {
    display: block;
    inline-size: 100%;
    padding: 0;
    border: 0;
    background: var(--surface);
    cursor: zoom-in;
  }
  .gallery__item :global(img) {
    inline-size: 100%;
  }

  .lightbox {
    inline-size: 100vw;
    block-size: 100dvh;
    max-inline-size: none;
    max-block-size: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: #050506;
    color: var(--ink);
    display: none;
    grid-template-rows: 1fr auto;
  }
  .lightbox::backdrop {
    background: #050506;
  }
  .lightbox[open] {
    display: grid;
  }
  .lightbox__swiper {
    inline-size: 100%;
    min-block-size: 0;
    padding-block-start: 3.5rem;
  }
  .lightbox__swiper :global(.swiper-slide) {
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .lightbox__swiper img {
    max-inline-size: 100%;
    max-block-size: calc(100dvh - 7rem);
    object-fit: contain;
    user-select: none;
  }
  .lightbox__count {
    flex: none;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .lightbox__caption {
    display: flex;
    gap: 1rem;
    justify-content: center;
    padding: 0.75rem 1rem;
    font-size: var(--step--1);
    color: var(--muted);
    text-align: center;
  }
  .lb-btn {
    position: absolute;
    display: grid;
    place-items: center;
    inline-size: 3rem;
    block-size: 3rem;
    border: 0;
    background: rgb(255 255 255 / 0.08);
    color: var(--ink);
    cursor: pointer;
  }
  .lb-btn:hover {
    background: var(--gold);
    color: var(--on-gold);
  }
  .lb-close {
    inset-block-start: 0.5rem;
    inset-inline-end: 0.5rem;
  }
  [dir='rtl'] .lb-prev svg,
  [dir='rtl'] .lb-next svg {
    transform: scaleX(-1);
  }
  .lb-prev,
  .lb-next {
    inset-block-start: 50%;
    translate: 0 -50%;
  }
  .lb-prev {
    inset-inline-start: 0.5rem;
  }
  .lb-next {
    inset-inline-end: 0.5rem;
  }
  /* On touch screens swiping replaces the arrows. */
  @media (hover: none) and (pointer: coarse) {
    .lb-prev,
    .lb-next {
      display: none;
    }
  }
</style>

<script>
  import type Swiper from 'swiper';

  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const items = [...root.querySelectorAll<HTMLButtonElement>('.gallery__item')];
    const dialog = root.querySelector<HTMLDialogElement>('dialog')!;
    const count = dialog.querySelector<HTMLElement>('.lightbox__count')!;
    const caption = dialog.querySelector<HTMLElement>('.lightbox__alt')!;
    const slides = [...dialog.querySelectorAll<HTMLImageElement>('.swiper-slide img')];
    let swiper: Swiper | undefined;

    const label = (i: number) => {
      count.textContent = `${i + 1} / ${slides.length}`;
      caption.textContent = slides[i]?.alt ?? '';
    };

    const open = async (i: number) => {
      dialog.showModal();
      label(i);
      if (swiper) return swiper.slideTo(i, 0);
      const { Swiper: SwiperClass, Navigation, Keyboard, Zoom, A11y } = await import('../scripts/swiper');
      swiper = new SwiperClass(dialog.querySelector<HTMLElement>('.swiper')!, {
        modules: [Navigation, Keyboard, Zoom, A11y],
        initialSlide: i,
        spaceBetween: 24,
        keyboard: { enabled: true },
        zoom: { maxRatio: 3 },
        navigation: { prevEl: dialog.querySelector<HTMLElement>('[data-prev]'), nextEl: dialog.querySelector<HTMLElement>('[data-next]') },
        on: { slideChange: (s) => label(s.activeIndex) },
      });
    };

    items.forEach((item, i) => item.addEventListener('click', () => open(i)));

    // Return focus to the thumbnail of the photo being viewed; reset any zoom.
    dialog.addEventListener('close', () => {
      swiper?.zoom.out();
      items[swiper?.activeIndex ?? 0]?.focus();
    });
    dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
  });
</script>
