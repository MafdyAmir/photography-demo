---
import { url } from '../lib/url';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import logo from '../assets/brand/shotix-logo-on-dark.png';
import { HALLS } from '../lib/content';
import { whatsappUrl } from '../lib/whatsapp';
import { t } from '../i18n/en';

interface Props {
  settings: CollectionEntry<'settings'>['data'];
  services: CollectionEntry<'services'>[];
}

const { settings, services } = Astro.props;
const year = new Date().getFullYear();
const social = [
  ['Instagram', settings.instagram],
  ['TikTok', settings.tiktok],
  ['Facebook', settings.facebook],
  ['LinkedIn', settings.linkedin],
].filter(([, href]) => href) as [string, string][];
---

<footer class="site-footer">
  <div class="container grid">
    <div class="brand">
      <Image src={logo} alt={settings.siteName} width={280} densities={[1, 2]} class="logo" />
      <p class="muted">{settings.location.areaServed ?? settings.location.city}</p>
      <p class="muted also">{t.common.alsoOffered}</p>
    </div>

    <nav aria-label="Footer">
      <h2 class="sign-label">{t.footer.explore}</h2>
      <ul role="list">
        {
          services.map((s) => (
            <li>
              <a href={url(`/services/${s.id}`)}>
                <span class="hall" aria-hidden="true">
                  {HALLS[s.data.category]}
                </span>
                {s.data.title}
              </a>
            </li>
          ))
        }
        <li><a href={url('/work')}>{t.nav.work}</a></li>
        <li><a href={url('/about')}>{t.nav.about}</a></li>
        <li><a href={url('/contact')}>{t.nav.contact}</a></li>
      </ul>
    </nav>

    <div>
      <h2 class="sign-label">{t.footer.contact}</h2>
      <ul role="list">
        <li>
          <a
            href={whatsappUrl(settings.whatsappNumber, settings.whatsappDefaultMessage)}
            target="_blank"
            rel="noopener"
            data-event="whatsapp_click"
            data-event-location="footer">WhatsApp</a
          >
        </li>
        <li>
          <a href={`mailto:${settings.email}`} data-event="email_click" data-event-location="footer">{settings.email}</a>
        </li>
        {
          social.map(([name, href]) => (
            <li>
              <a href={href} target="_blank" rel="noopener">
                {name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="container bottom">
    <p>© {year} {settings.siteName}. {t.footer.rights}</p>
    <a href={url('/privacy')}>{t.footer.privacy}</a>
  </div>
</footer>

<style>
  .site-footer {
    border-block-start: 1px solid var(--line);
    padding-block: clamp(3.5rem, 2rem + 5vw, 6rem) 2rem;
  }
  .site-footer a {
    text-decoration: none;
  }
  .site-footer a:hover {
    color: var(--gold);
  }
  .grid {
    display: grid;
    gap: 2.75rem;
  }
  @media (min-width: 48em) {
    .grid {
      grid-template-columns: 1.6fr 1fr 1fr;
    }
  }
  .brand :global(.logo) {
    inline-size: min(17.5rem, 80%);
    block-size: auto;
    margin-block-end: 1.25rem;
  }
  .also {
    margin-block-start: 0.75rem;
    max-inline-size: 26rem;
  }
  .sign-label {
    margin-block-end: 0.9rem;
  }
  li + li {
    margin-block-start: 0.55rem;
  }
  li a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-block-size: 1.75rem;
  }
  .hall {
    display: inline-grid;
    place-items: center;
    inline-size: 1.5rem;
    block-size: 1.5rem;
    background: var(--gold);
    color: var(--on-gold);
    font: 900 0.95rem / 1 var(--font-sign);
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-block-start: 3.5rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--line);
    font-size: var(--step--1);
    color: var(--muted);
  }
</style>
