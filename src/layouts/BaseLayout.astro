---
import type { ImageMetadata } from 'astro';
import { Font, getImage } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import Analytics from '../components/Analytics.astro';
import { getServices, getSettings } from '../lib/content';
import { locale, t } from '../i18n/en';

interface Props {
  /** Page title without the site name. Omit on Home to use the default SEO title. */
  title?: string;
  description?: string;
  /** Share image for WhatsApp / LinkedIn previews. Falls back to the default from Site Settings. */
  image?: ImageMetadata;
  ogType?: 'website' | 'article';
  /** Pre-filled WhatsApp message for this page (PRD FR-2). */
  whatsappMessage?: string;
  noindex?: boolean;
}

const settings = await getSettings();
const services = await getServices();
const {
  title,
  description = settings.defaultSeo.description,
  image = settings.defaultSeo.ogImage ?? settings.heroImage.src,
  ogType = 'website',
  whatsappMessage,
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} | ${settings.siteName}` : settings.defaultSeo.title;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), Astro.site);
const og = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpeg', quality: 80 });
const ogUrl = new URL(og.src, Astro.site);
const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION as string | undefined;
---

<!doctype html>
<html lang={locale.lang} dir={locale.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#f6f4f0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={settings.siteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title ?? settings.defaultSeo.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {gscVerification && <meta name="google-site-verification" content={gscVerification} />}

    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-serif" preload />
    <Analytics />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.nav.skip}</a>
    <Header siteName={settings.siteName} services={services} />
    <main id="main">
      <slot />
    </main>
    <Footer settings={settings} services={services} />
    <WhatsAppFab number={settings.whatsappNumber} message={whatsappMessage ?? settings.whatsappDefaultMessage} />
  </body>
</html>
