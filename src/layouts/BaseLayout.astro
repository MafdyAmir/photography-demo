---
import { url } from '../lib/url';
import type { ImageMetadata } from 'astro';
import { Font, getImage } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DateCheck from '../components/DateCheck.astro';
import Analytics from '../components/Analytics.astro';
import Iris from '../components/Iris.astro';
import { getServices, getSettings } from '../lib/content';
import { locale, t } from '../i18n/en';

interface Props {
  /** Page title without the site name. Omit on Home to use the default SEO title. */
  title?: string;
  description?: string;
  /** Share image for WhatsApp / LinkedIn previews. Falls back to the default from Site Settings. */
  image?: ImageMetadata;
  ogType?: 'website' | 'article';
  /** Service name added to the sticky "Check your date" message. */
  service?: string;
  /** Hide the sticky phone bar (contact and thank-you pages already lead to contact). */
  hideDateBar?: boolean;
  noindex?: boolean;
}

const settings = await getSettings();
const services = await getServices();
const {
  title,
  description = settings.defaultSeo.description,
  image = settings.defaultSeo.ogImage ?? settings.heroImage.src,
  ogType = 'website',
  service,
  hideDateBar = false,
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} | ${settings.siteName}` : settings.defaultSeo.title;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), Astro.site);
const og = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpeg', quality: 80 });
const ogUrl = new URL(og.src, Astro.site);
const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION as string | undefined;
---

<!doctype html>
<html lang={locale.lang} dir={locale.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0a0a0b" />
    <link rel="icon" href={url('/favicon.png')} type="image/png" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={settings.siteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title ?? settings.defaultSeo.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {gscVerification && <meta name="google-site-verification" content={gscVerification} />}

    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-display" preload />
    <Analytics />
    <!-- Arriving through the camera iris: start shut, before first paint (Iris.astro opens it). -->
    <script is:inline>
      try {
        if (sessionStorage.getItem('iris') && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('iris-in');
          setTimeout(() => document.documentElement.classList.remove('iris-in'), 3000);
        }
      } catch {}
    </script>
    <slot name="head" />
  </head>
  <body class:list={[!hideDateBar && 'has-date-bar']}>
    <Iris />
    <a class="skip-link" href="#main">{t.nav.skip}</a>
    <Header siteName={settings.siteName} services={services} />
    <main id="main">
      <slot />
    </main>
    <Footer settings={settings} services={services} />
    {!hideDateBar && <DateCheck variant="bar" service={service} location="sticky_bar" />}
  </body>
</html>
