---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { getSettings } from '../lib/content';
import { whatsappUrl } from '../lib/whatsapp';
import { t } from '../i18n/en';

const settings = await getSettings();
const social = [
  ['Instagram', settings.instagram],
  ['TikTok', settings.tiktok],
  ['Facebook', settings.facebook],
  ['LinkedIn', settings.linkedin],
].filter(([, href]) => href) as [string, string][];
---

<BaseLayout
  title={`${t.contact.title} — Contact`}
  description={`Book photo and video coverage for your event, exhibition or launch with ${settings.siteName} in ${settings.location.city}. Send an inquiry or message on WhatsApp.`}
  hideDateBar
>
  <section class="section contact">
    <div class="container layout">
      <div class="main stack" style="--stack: 1.5rem">
        <h1>{t.contact.title}</h1>
        <p class="lead">{t.contact.intro}</p>

        <!-- Project Inquiry Form (PRD FR-1) -->
        <div id="inquiry">
          <InquiryForm />
        </div>
      </div>

      <aside class="aside stack" aria-labelledby="direct">
        <h2 id="direct" class="sign-label">{t.contact.other}</h2>
        <a
          class="btn"
          href={whatsappUrl(settings.whatsappNumber, settings.whatsappDefaultMessage)}
          target="_blank"
          rel="noopener"
          data-event="whatsapp_click"
          data-event-location="contact"
        >
          <WhatsAppIcon />
          {t.common.chatOnWhatsApp}
        </a>
        <dl class="details">
          <div>
            <dt class="sign-label">{t.common.email}</dt>
            <dd>
              <a href={`mailto:${settings.email}`} data-event="email_click" data-event-location="contact">
                {settings.email}
              </a>
            </dd>
          </div>
          {
            social.length > 0 && (
              <div>
                <dt class="sign-label">Social</dt>
                <dd class="social">
                  {social.map(([name, href]) => (
                    <a href={href} target="_blank" rel="noopener">
                      {name}
                    </a>
                  ))}
                </dd>
              </div>
            )
          }
          <div>
            <dt class="sign-label">{t.contact.based}</dt>
            <dd>{settings.location.areaServed ?? settings.location.city}</dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .layout {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 56em) {
    .layout {
      grid-template-columns: 2fr 1fr;
      gap: 5rem;
    }
  }
  .contact {
    padding-block-start: clamp(2rem, 1rem + 4vw, 4rem);
  }
  .aside {
    align-self: start;
    padding: 1.75rem;
    background: var(--navy);
    --stack: 1.25rem;
  }
  .aside .btn {
    inline-size: 100%;
  }
  .details {
    display: grid;
    gap: 1.25rem;
    margin-inline: 0;
    margin-block-end: 0;
  }
  .details dd {
    margin: 0.25rem 0 0;
    overflow-wrap: anywhere;
  }
  .social {
    display: flex;
    gap: 1.25rem;
  }
</style>
