---
import { url } from '../lib/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import { getSettings } from '../lib/content';
import { whatsappUrl } from '../lib/whatsapp';
import { t } from '../i18n/en';

const settings = await getSettings();
---

<BaseLayout title="Thank You" description="Your project inquiry was sent." noindex hideDateBar>
  <section class="section">
    <div class="container narrow stack" style="--stack: 1.5rem">
      <h1>Thanks. Your inquiry is with us.</h1>
      <p class="lead">
        We’ll read it and get back to you by email or WhatsApp with how we’d cover your event.
      </p>
      <p>Need to add something or talk sooner? Message us on WhatsApp.</p>
      <div class="btn-row">
        <a
          class="btn"
          href={whatsappUrl(settings.whatsappNumber, 'Hi, I just sent a project inquiry through your website.')}
          target="_blank"
          rel="noopener"
          data-event="whatsapp_click"
          data-event-location="thank_you"
        >
          <WhatsAppIcon />
          {t.common.chatOnWhatsApp}
        </a>
        <a class="btn btn--ghost" href={url('/work')}>{t.common.viewWork}</a>
      </div>
    </div>
  </section>
</BaseLayout>
